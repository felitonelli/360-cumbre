---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" descripcion="La página que buscás no existe o cambió de lugar.">
  <div class="contenedor seccion max-w-2xl pt-36 text-center sm:pt-44">
    <p class="sobretitulo">Error 404</p>
    <h1 class="titulo">Esta página se perdió en las sierras</h1>
    <p class="bajada mx-auto">La página que buscás no existe o cambió de lugar.</p>
    <a href="/" class="btn btn-principal mt-8">Volver al inicio</a>
  </div>
</Base>
