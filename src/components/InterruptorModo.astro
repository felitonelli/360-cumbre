---
// Pasa la página de noche a día y al revés. El estado lo maneja scripts/modo.ts;
// acá solo se dibuja: una pieza clara se desliza hasta el ícono del modo activo.
import Icono from './Icono.astro';
---

<button
  type="button"
  class="interruptor relative flex shrink-0 cursor-pointer gap-0.5 rounded-full border border-current/25 bg-carbon-950/30 p-1 backdrop-blur-sm"
  aria-label="Modo noche"
  aria-pressed="true"
  data-interruptor
>
  <span class="pulgar absolute top-1 left-1 size-9 rounded-full bg-crema-100" aria-hidden="true"></span>
  <span class="i-dia relative grid size-9 place-items-center rounded-full">
    <Icono nombre="sun" class="size-[1.15rem]" />
  </span>
  <span class="i-noche relative grid size-9 place-items-center rounded-full">
    <Icono nombre="flame" class="size-[1.15rem]" />
  </span>
</button>

<style>
  .pulgar {
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.6),
      0 2px 6px rgb(0 0 0 / 0.3);
    transition: transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* El ancho de un ícono más el espacio entre los dos. */
  :global([data-modo='noche']) .pulgar {
    transform: translateX(calc(100% + 0.125rem));
  }

  .i-dia,
  .i-noche {
    opacity: 0.75;
    transition:
      color 0.3s ease,
      opacity 0.3s ease;
  }

  :global([data-modo='dia']) .i-dia,
  :global([data-modo='noche']) .i-noche {
    color: var(--color-carbon-900);
    opacity: 1;
  }

  :global([data-modo='noche']) .i-noche :global(svg) {
    color: var(--color-cobre-600);
    filter: drop-shadow(0 0 3px rgb(232 163 61 / 0.55));
  }

  :global([data-modo='dia']) .i-dia :global(svg) {
    color: var(--color-cobre-700);
  }

  .interruptor:hover .i-dia,
  .interruptor:hover .i-noche {
    opacity: 1;
  }
</style>
