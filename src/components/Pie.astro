---
import { direccionCorta, linkInstagram, linkWhatsApp, site } from '../config/site';
import IconoMarca from './IconoMarca.astro';
import Marca from './Marca.astro';
import Sierra from './Sierra.astro';
---

<footer class="siempre-noche relative pt-20 pb-32 sm:pt-28 lg:pb-14">
  <Sierra variante={2} />
  <div class="contenedor">
    <div class="flex flex-col gap-10 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="text-[clamp(3.5rem,14vw,7rem)]"><Marca /></p>
        <p class="mt-4 max-w-md text-lg text-tinta-suave">{site.eslogan}</p>
        <p class="mt-1 text-tinta-suave">{direccionCorta}</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a
          href={linkWhatsApp()}
          target="_blank"
          rel="noopener"
          class="btn btn-principal"
          data-evento="whatsapp_click"
          data-ubicacion="pie"
        >
          <IconoMarca marca="whatsapp" class="size-5" />
          WhatsApp
        </a>
        {
          linkInstagram && (
            <a href={linkInstagram} target="_blank" rel="noopener" class="btn btn-contorno">
              <IconoMarca marca="instagram" class="size-5" />@{site.instagram}
            </a>
          )
        }
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-linea pt-6 text-sm text-tinta-suave sm:flex-row sm:items-center sm:justify-between"
    >
      <p>
        {`© ${new Date().getFullYear()} ${site.nombre}`} · <a href="/privacidad" class="underline-offset-4 hover:underline">Privacidad</a>
        {site.modoPropuesta && <span> · Algunas fotos son ilustrativas (Unsplash)</span>}
      </p>
      {
        site.credito.nombre && (
          <p>
            Sitio hecho por{' '}
            {site.credito.url ? (
              <a href={site.credito.url} target="_blank" rel="noopener" class="font-semibold text-tinta underline-offset-4 hover:underline">
                {site.credito.nombre}
              </a>
            ) : (
              <span class="font-semibold text-tinta">{site.credito.nombre}</span>
            )}
          </p>
        )
      }
    </div>
  </div>
</footer>
